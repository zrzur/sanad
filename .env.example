# Zrzur → Settings → My Bots → copy bot token
ZRZUR_BOT_TOKEN=zrzur_bot_xxxxxxxxxxxxxxxxxxxxxxxx.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Comma-separated Zrzur user ids allowed to run /instance (multi-bot)
SANAD_OWNER_IDS=

# Defaults
SANAD_PREFIX=!
SANAD_LOCALE=ar

# Enable Message Content + Server Members + Message Reactions in Zrzur → My Bots
# then uncomment:
# SANAD_PRIVILEGED_INTENTS=1

# Optional: sync slash commands to one server while developing
# ZRZUR_SERVER_ID=

# Self-hosted Zrzur only
# ZRZUR_API_URL=http://127.0.0.1:14702
# ZRZUR_WS_URL=ws://127.0.0.1:14703

# Spotify Web API (catalog search → full-length matched audio)
# Create an app at https://developer.spotify.com/dashboard
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
